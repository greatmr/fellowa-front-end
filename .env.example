# Copy to .env.local and fill in. Never commit .env.local, and never paste a
# value from it into code, logs, a reply or a document.

# Base URL of the Fellowa NestJS API, including its /api prefix; no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Canonical browser origin, including the development port. Required for auth
# Server Action Origin validation and absolute URLs; use HTTPS in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true only for a build that must run without a configured backend
# (CI type-check, image build). Never set it in a running environment.
# SKIP_ENV_VALIDATION=true
